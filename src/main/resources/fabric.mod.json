{
	"schemaVersion": 1,
	"id": "myriad-essentials",
	"version": "${version}",
	"name": "Myriad Essentials",
	"description": "The stock module set for Myriad. Built purely on the public Myriad addon API; remove it and Myriad runs with no modules.",
	"authors": ["Myriad"],
	"icon": "assets/myriad-essentials/icon.png",
	"license": "CC0-1.0",
	"contact": {
		"sources": "https://github.com/MyriadClient/myriad-essentials",
		"issues": "https://github.com/MyriadClient/myriad-essentials/issues"
	},
	"environment": "client",
	"entrypoints": {
		"myriad": [
			"dev.myriadclient.essentials.Essentials"
		]
	},
	"mixins": [
		"myriad-essentials.mixins.json"
	],
	"depends": {
		"myriad": ">=${myriad_version}",
		"minecraft": "~${minecraft_version}"
	},
	"suggests": {
		"litematica": "*"
	},
	"custom": {
		"myriad": {
			"keys": [
				"ed25519:ZW9yhFbw987SYNvs23DvHSAnLhXte8RfyQfEX1j8SgU",
				"ed25519:kJS2ev_PWdfEjBokzpOCqliecb-93Kv7zYoRCPSF4Ks"
			]
		}
	}
}
