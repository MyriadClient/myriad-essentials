def online():
    return re.search(rf"(?<![\w]){P}(?![\w])", cmd("list").split(":", 1)[-1]) is not None


def rejoin():
    client("connect localhost:25565", timeout=10)
    for _ in range(60):
        if online():
            time.sleep(3)
            return True
        time.sleep(1)
    return False


def leaves_within(seconds):
    end = time.time() + seconds
    while time.time() < end:
        if not online():
            return True
        time.sleep(0.1)
    return False


