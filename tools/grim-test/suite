# Every hotbar slot taken, with nothing Middle Click may use and no building blocks for a borrow to go over.
FULL_HOTBAR = ["diamond_sword", "diamond_pickaxe", "diamond_axe", "diamond_shovel", "bow", "shield", "golden_apple", "totem_of_undying", "shears"]


def hotbar():
    return [item(i).removeprefix("minecraft:") for i in range(9)]


def t_middle_click_inventory():
    # No pearl in the hotbar and no free slot: one comes from the inventory over another slot, and both go back after.
    # The wait before the click lets the items reach the client through lag.py.
    reset()
    cmd(*(f"item replace entity {P} hotbar.{i} with {t}" for i, t in enumerate(FULL_HOTBAR)), f"item replace entity {P} inventory.5 with ender_pearl 16")
    log = [".packets log on"] if os.environ.get("PRINT_LOG") else []
    client(*log, ".set middle_click air pearl", ".set middle_click block pearl", ".toggle middle_click on", "look -90 -60", "wait 10", "middle", "wait 60",
        ".toggle middle_click off", *([".packets log off"] if log else []))
    pearls, now = count(14), hotbar()
    # Thrown nearly straight up, it would land and teleport the tester in the middle of the next test.
    cmd("kill @e[type=ender_pearl]")
    return pearls == 15 and now == FULL_HOTBAR, f"{pearls} pearls back in the inventory, hotbar {'as it was' if now == FULL_HOTBAR else now}"


def t_middle_click_rocket_flying():
    # A rocket from the inventory while gliding: there's never a still moment, so the click goes while flying.
    client(*FRESH, "wait 20")
    cmd(f"clear {P}", f"gamemode survival {P}", f"item replace entity {P} armor.chest with elytra",
        *(f"item replace entity {P} hotbar.{i} with {t}" for i, t in enumerate(FULL_HOTBAR)), f"item replace entity {P} inventory.5 with firework_rocket 16",
        f"tp {P} 6000.5 300 0.5 -90 0")
    time.sleep(1.5)
    mark()
    x0 = position()[0]
    client(".set middle_click flying rocket", ".toggle middle_click on", "look -90 -10", "hold jump 2", "wait 5", "middle", "wait 100",
        ".toggle middle_click off", timeout=60)
    rockets, now, x = count(14), hotbar(), position()[0]
    return rockets == 15 and now == FULL_HOTBAR, f"{rockets} rockets back in the inventory, hotbar {'as it was' if now == FULL_HOTBAR else now}, {x - x0:.0f} blocks"


# The Printer: a row of blocks built with server commands (the reference) is saved as a Litematica schematic and placed
# PRINT_DZ away, and the Printer builds it while the tester walks, sprints or jumps past; the server then compares the
# two rows block for block, and reads the hotbar and off hand, which must be as they were.
PRINT_X, PRINT_Y, PRINT_Z, PRINT_DZ = 8000, 100, 0, 8
# Every block here can be placed from the row's own floor and neighbours (a log along z would need a block north or
# south of it to be clicked; this row has none).
PRINT_ROW = ["stone", "oak_log[axis=x]", "oak_stairs[facing=north]", "stone_brick_slab[type=top]", "cobblestone", "birch_planks",
             "stone_stairs[facing=south]", "smooth_stone_slab[type=bottom]", "glass", "furnace[facing=north]", "spruce_log[axis=y]",
             "brick_stairs[facing=east]"] * 2
PRINT_ITEMS = sorted({b.split("[")[0] for b in PRINT_ROW})
PRINT_HOTBAR = {0: "diamond_sword", 1: "diamond_pickaxe", 2: "golden_apple"}


def has_litematica():
    """Whether the running dev client loaded Litematica (started with -Plitematica)."""
    try:
        log = open(os.path.join(HERE, "..", "..", RUN, "logs", "latest.log"), errors="replace").read()
    except OSError:
        return False
    return re.search(r"(?m)^\s*- litematica", log) is not None


def printer_pass(keys, rotate, air, stand=None, lenient=False, hotbar=PRINT_HOTBAR, settings=(), omit=(), setup=(), start=(-4.5, -1.5), ticks=140,
                 left_out=(), stop_ticks=40):
    if not has_litematica(): return True, "skipped: Litematica isn't in the dev client (start it with -Plitematica)"
    x0, y, z = PRINT_X, PRINT_Y, PRINT_Z
    client(*FRESH, ".printscene clear", "wait 5")
    n = len(PRINT_ROW)
    forceload_area(x0 - 32, z - 8, x0 + n + 48, z + PRINT_DZ + 8)
    cmd(f"fill {x0 - 30} {y - 1} {z - 6} {x0 + n + 44} {y - 1} {z + PRINT_DZ + 2} stone", f"fill {x0 - 30} {y} {z - 6} {x0 + n + 44} {y + 6} {z + PRINT_DZ + 2} air",
        *(f"setblock {x0 + i} {y} {z + PRINT_DZ} {b}" for i, b in enumerate(PRINT_ROW)),
        f"gamemode survival {P}", f"clear {P}", f"effect clear {P}", f"kill @e[type=item,x={x0},y={y},z={z},distance=..60]",
        f"item replace entity {P} weapon.offhand with totem_of_undying",
        *(f"item replace entity {P} hotbar.{i} with {t}" for i, t in hotbar.items()),
        *(f"item replace entity {P} inventory.{k} with {it} 16" for k, it in enumerate(PRINT_ITEMS) if it not in omit), *setup,
        f"tp {P} {x0 + start[0]} {y} {z + start[1]} -90 20", f"effect give {P} saturation 1 20 true")
    settle(x0 + start[0], y, z + start[1])
    client(f".printscene {x0} {y} {z + PRINT_DZ} {x0 + n - 1} {y} {z + PRINT_DZ} 0 0 {-PRINT_DZ}", f".set printer rotate {str(rotate).lower()}",
        f".set printer air_place {str(air).lower()}", ".set printer click_settings true", ".set printer break_wrong_blocks false",
        ".set printer order bottom_up", ".set printer skip clear", ".set printer walk_to_blocks false", ".set printer restock false", *settings, "wait 5")
    if lenient:
        # 2b2t's Grim takes air placements and clicks on faces you don't look at; this one would cancel them. Deopped, the
        # tester has myriad.lenientplace (start.sh), so they're only flagged and the game decides where blocks go.
        # Grim reads permissions when you join and when it reloads.
        cmd(f"deop {P}", "grim reload")
    mark()
    # Past the row and a little beyond, then time for what's still in reach, then off: what it moved goes back.
    if stand is None:
        # PRINT_LOG=1: the client logs every packet of the pass (.packets log, in run/myriad/packets); PRINT_LOG=all keeps
        # the received packets the log leaves out as noise (attribute updates, entity moves).
        log = [".packets log on" + (" all" if os.environ.get("PRINT_LOG") == "all" else "")] if os.environ.get("PRINT_LOG") else []
        moving = [f"hold {keys} {ticks}", f"wait {ticks + 10}"] if keys else [f"wait {ticks}"]
        client(*log, ".toggle printer on", *moving, "wait 60", ".toggle printer off", *([".packets log off"] if log else []), "wait 60",
            ".printscene clear", timeout=90 + ticks // 20)
    else:
        # Standing still at each of these x in turn, long enough for everything in reach.
        steps = [".toggle printer on"]
        for sx in stand:
            steps += [f"/tp {P} {x0 + sx + 0.5} {y} {z - 1.5} -90 20", f"wait {stop_ticks}"]
        client(*steps, ".toggle printer off", "wait 60", ".printscene clear", timeout=120)
    if lenient:
        cmd(f"op {P}", "grim reload")
        # The flags it takes leave Grim's RotationPlace checking every later placement by the look at the click, for
        # as long as the session lasts: a fresh one, so the tests after it on this client aren't judged by that.
        cmd(f"kick {P} fresh Grim session")
        time.sleep(4.5)
        if not rejoin(): return False, "couldn't rejoin after the pass"
    # Blocks left out on purpose (Skip) must stay air; the rest are judged as usual.
    skipped = [i for i, b in enumerate(PRINT_ROW) if b.split("[")[0] in left_out]
    placed_skipped = [i for i in skipped if not passed(f"if block {x0 + i} {y} {z} air")]
    off = [i for i, b in enumerate(PRINT_ROW) if i not in skipped
           and not passed(f"if blocks {x0 + i} {y} {z + PRINT_DZ} {x0 + i} {y} {z + PRINT_DZ} {x0 + i} {y} {z} all")]
    n -= len(skipped)
    # Not placed (still air) is one thing, which a pass back fixes; a different block or state there is a misplace.
    missing = [i for i in off if passed(f"if block {x0 + i} {y} {z} air")]
    wrong = [f"{x0 + i}:{PRINT_ROW[i]}" for i in off if i not in missing]
    hotbar_now = {i: item(i).removeprefix("minecraft:") for i in range(9)}
    expected = {i: hotbar.get(i, "") for i in range(9)}
    offhand = item(-106).removeprefix("minecraft:")
    moved = {i: hotbar_now[i] for i in range(9) if hotbar_now[i] != expected[i]}
    # Standing at fixed stops, some blocks have no face to click from any of them: there, only misplaces fail.
    ok = not (wrong if stand else off) and not moved and offhand == "totem_of_undying" and not placed_skipped
    return ok, (f"{n - len(off)}/{n} right, {len(missing)} not placed, {len(wrong)} wrong" + (f" ({', '.join(wrong[:6])})" if wrong else "")
                + (f", {len(skipped) - len(placed_skipped)}/{len(skipped)} skipped left out" if skipped else "")
                + f", hotbar {'as it was' if not moved else moved}, off hand {offhand or 'empty'}")


