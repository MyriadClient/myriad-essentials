#!/usr/bin/env python3
"""Runs the Essentials test suite against the local Grim server and the dev client, and prints a table.

  ./suite              every test
  ./suite kill_aura    tests whose name contains any of the words given
  ./suite --list       the tests
  ./suite --workers 3  shared out between three dev clients (./clients 3 starts them), side by side

Needs the server (./start.sh) and the dev client in game as GrimTester (op). Each test sets up its own scene (most of
them on a stone floor around x=1000 so they don't touch the rest of the world), runs client steps, then checks the
result on the server and that Grim flagged nothing. Exit code 1 if anything failed.
"""
import json, math, os, re, subprocess, sys, threading, time

HERE = os.path.dirname(os.path.abspath(__file__))
# Which dev client this runs with (./suite --workers runs one copy per client): the first is GrimTester in the overworld,
# the others GrimTester2.. each in a flat world of its own (datapack/myriad-tests), so every test keeps its coordinates.
WORKER = int(os.environ.get("GRIM_WORKER", "1"))
P = "GrimTester" if WORKER == 1 else f"GrimTester{WORKER}"
RUN = "run" if WORKER == 1 else f"run{WORKER}"
DIM = None if WORKER == 1 else f"myriad:t{WORKER}"
CONSOLE = os.path.join(HERE, "server", "console.log")
TIMES = os.path.join(HERE, ".suite-times.json")
# GRIM_STRICT=1: the server was started with --strict and the client with -Pstrict (current Grim, keys judged).
STRICT = os.environ.get("GRIM_STRICT") == "1"
# The test floor: stone at y=99, air above, around x=1000 z=0. The air in two fills: one would be over the server's
# 32768-block limit, fail, and leave what earlier tests built.
ARENA = ["fill 980 99 -20 1040 99 20 stone", "fill 980 100 -20 1040 107 20 air", "fill 980 108 -20 1040 115 20 air"]


def sh(*args, timeout=180):
    r = subprocess.run([os.path.join(HERE, args[0]), *args[1:]], capture_output=True, text=True, timeout=timeout)
    return r.stdout + r.stderr


def cmd(*commands):
    """Server commands; in this worker's world (so its tests can use the same coordinates as the others')."""
    if DIM:
        commands = [f"execute in {DIM} " + c[len("execute "):] if c.startswith("execute ") else f"execute in {DIM} run {c}" for c in commands]
    return sh("cmd", *commands)


def client(*steps, timeout=120):
    return sh("client", "--run", RUN, "--timeout", str(timeout), *steps, timeout=timeout + 30)


_mark = 0


def mark():
    """Grim's flags count from here (for this worker's player)."""
    global _mark
    _mark = os.path.getsize(CONSOLE)


def flags():
    """The checks Grim flagged this worker's player for since the mark."""
    with open(CONSOLE, "rb") as f:
        f.seek(_mark)
        text = re.sub(r"\x1b\[[0-9;]*m", "", f.read().decode(errors="replace"))
    found = set()
    for m in re.finditer(rf"(?<![\w]){P} failed (\w+)[^\n]*", text):
        # Like 2b2t (start.sh): a click over held keys only flags there. Over sprinting or sneaking it still fails.
        if not STRICT and m.group(1) in ("MultiActionsC", "MultiActionsD") and "sprinting=false, sneaking=false, input=true" in m.group(0):
            continue
        found.add(m.group(1))
    return sorted(found)


def passed(condition):
    """Runs an execute if/unless test on the server."""
    return "passed" in cmd("execute " + condition)


def data(path):
    out = cmd(f"data get entity {P} {path}")
    m = re.search(r"entity data: (.*)", out)
    return m.group(1).strip() if m else ""


def count(slot):
    """The item count in an inventory slot number as the server stores it (0-8 hotbar, 9-35 main, -106 off hand)."""
    m = re.search(r"count: (\d+)", data(f"Inventory[{{Slot:{slot}b}}]"))
    return int(m.group(1)) if m else 0


def item(slot):
    m = re.search(r'id: "([^"]+)"', data(f"Inventory[{{Slot:{slot}b}}]"))
    return m.group(1) if m else ""


def position():
    nums = re.findall(r"(-?[\d.]+)d", data("Pos"))
    return tuple(float(n) for n in nums[:3]) if len(nums) >= 3 else (0, 0, 0)


def forceload(*chunks, timeout=30):
    """Force-loads chunks (as (chunk x, chunk z)) and waits until the server has them all: a new world generates them
    first, and a fill reaching one that isn't in yet fails."""
    cmd(*[f"forceload add {cx * 16} {cz * 16}" for cx, cz in chunks])
    end = time.time() + timeout
    left = list(chunks)
    while left and time.time() < end:
        out = cmd(*[f"execute if loaded {cx * 16} 0 {cz * 16}" for cx, cz in left])
        # One answer per command, in order.
        answers = re.findall(r"Test (passed|failed)", out)
        if len(answers) == len(left):
            left = [c for c, a in zip(left, answers) if a == "failed"]
        if left: time.sleep(0.25)


def forceload_area(x1, z1, x2, z2):
    forceload(*[(cx, cz) for cx in range(x1 >> 4, (x2 >> 4) + 1) for cz in range(z1 >> 4, (z2 >> 4) + 1)])


_arena_loaded = False


def settle(x, y, z, timeout=5.0):
    """Waits until the client stands where the tester was teleported (it has taken the teleport and has the chunks
    there), then a few ticks more for Grim to have its answer, a few seconds at most."""
    end = time.time() + timeout
    while time.time() < end:
        m = re.search(r"status: pos ([-\d.]+) ([-\d.]+) ([-\d.]+) .* ground=(\w+)", client("status", timeout=10))
        if m and abs(float(m.group(1)) - x) < 0.05 and abs(float(m.group(2)) - y) < 0.05 and abs(float(m.group(3)) - z) < 0.05 and m.group(4) == "true":
            break
    client("wait 5", timeout=10)


# Respawned with every module off (.panic), then Elytra Swap back on for Elytra Fly's flights (No Durability, its
# setting before it became a module, was on by default) but not for flying yourself.
FRESH = ("closescreen", "respawn", ".panic", ".set elytra_swap when_you_fly false", ".toggle elytra_swap on")


def reset(x=1000.5, y=100, z=0.5, yaw=-90, pitch=0, arena=True):
    global _arena_loaded
    client(*FRESH, "wait 5")
    # The server only changes loaded chunks: the arena's stay loaded, so it's built before the tester gets there.
    if not _arena_loaded:
        forceload_area(976, -32, 1047, 31)
        _arena_loaded = True
    cmd(*(ARENA if arena else []), f"gamemode survival {P}", f"clear {P}", f"effect clear {P}", f"kill @e[type=!player,distance=..64,x={x},y={y},z={z}]",
        f"tp {P} {x} {y} {z} {yaw} {pitch}", f"effect give {P} saturation 1 20 true")
    settle(x, y, z)
    # Grim's opinion of the setup (teleports) isn't the module's: count flags from here.
    mark()


# ---- tests: each returns (ok, detail) -----------------------------------------------------------------------------------

def t_anticheat():
    out = client(".anticheat")
    return "Grim detected" in out, out.strip().splitlines()[-1] if out.strip() else "no output"


def t_selftest():
    # Looking down at the floor, with a bedrock hole and an obsidian crystal base nearby for the helpers to find.
    reset(pitch=30)
    cmd(f"item replace entity {P} hotbar.0 with diamond_sword", f"item replace entity {P} inventory.0 with totem_of_undying",
        f"item replace entity {P} hotbar.8 with cooked_beef 16", "setblock 1005 99 4 bedrock", "fill 1004 100 4 1006 100 4 bedrock",
        "setblock 1005 100 3 bedrock", "setblock 1005 100 5 bedrock", "setblock 1005 100 4 air", "setblock 1002 100 -3 obsidian")
    time.sleep(1)
    out = client("selftest 20 -auto_disconnect", timeout=600)
    m = re.search(r"selftest: (\d+) modules run, (\d+) failures", out)
    fails = [l.split("FAIL ", 1)[1] for l in out.splitlines() if "selftest: FAIL" in l]
    helpers = next((l.split("helpers: ", 1)[1] for l in out.splitlines() if "selftest: helpers:" in l), "")
    if not m:
        return False, "no selftest report"
    h = re.search(r"(\d+) holes, (\d+) crystal bases, snowball lands \(([-\d.]+), ([-\d.]+), ([-\d.]+)\)", helpers)
    helpers_ok = bool(h) and int(h.group(1)) >= 1 and int(h.group(2)) >= 1 and abs(float(h.group(4)) - 100) < 0.01
    return int(m.group(2)) == 0 and helpers_ok, f"{m.group(1)} modules, {m.group(2)} failures" + ("; " + "; ".join(fails[:3]) if fails else "") \
        + (f" | helpers{'' if helpers_ok else ' WRONG'}: {helpers}" if helpers else "")


def t_kill_aura_holding():
    reset()
    cmd(f"item replace entity {P} hotbar.0 with diamond_sword", "summon husk 1003.5 100 0.5 {NoAI:1b,Health:10f,Tags:[\"suite\"]}")
    time.sleep(0.5)
    client("select 1", ".set kill_aura weapon holding", ".toggle kill_aura on", "wait 60", ".toggle kill_aura off")
    return passed("unless entity @e[tag=suite]"), "husk killed with the held sword"


def t_kill_aura_switch():
    reset()
    cmd(f"item replace entity {P} inventory.4 with diamond_sword", f"item replace entity {P} hotbar.0 with dirt 16",
        "summon husk 1003.5 100 0.5 {NoAI:1b,Health:10f,Tags:[\"suite\"]}")
    time.sleep(0.5)
    out = client("select 1", ".set kill_aura weapon switch", ".toggle kill_aura on", "wait 80", "status", ".toggle kill_aura off", "wait 30", ".set kill_aura weapon holding")
    shown = re.search(r"item=(\S+)", out)
    killed = passed("unless entity @e[tag=suite]")
    back = item(13) == "minecraft:diamond_sword"
    return killed and back and shown and shown.group(1).endswith("dirt"), f"killed={killed}, hand showed {shown.group(1) if shown else '?'}, sword back in inventory={back}"


def t_kill_aura_walking():
    # Husks beside the path, so it turns you while you walk diagonally: walking follows the sent yaw (the move fix),
    # which as 1.20.4 has to move exactly as that version did (a diagonal isn't normalised there).
    reset()
    cmd(f"item replace entity {P} hotbar.0 with diamond_sword")
    for x in range(1004, 1030, 4):
        cmd(f'summon husk {x}.5 100 2.5 {{NoAI:1b,Health:1000f,attributes:[{{id:"minecraft:max_health",base:1000}}],Tags:["suite"]}}')
    time.sleep(0.5)
    mark()
    client("select 1", ".set kill_aura weapon holding", ".toggle kill_aura on", "hold forward,sprint 80", "wait 82", ".toggle kill_aura off")
    x, _, _ = position()
    return x > 1012, f"walked to x={x:.1f} beside the husks"


def t_packet_mine():
    reset()
    cmd("setblock 1003 100 0 deepslate", f"item replace entity {P} hotbar.0 with netherite_pickaxe", f"item replace entity {P} hotbar.1 with dirt 16")
    # Eyes at (1000.5, 101.62, 0.5) to the block's centre (1003.5, 100.5, 0.5).
    client("select 2", ".toggle packet_mine on", "look -90 20.47", "wait 2", "attack", "wait 40", ".toggle packet_mine off")
    return passed("if block 1003 100 0 air"), "deepslate mined with the pickaxe from another slot"


def t_scaffold():
    reset(z=-10.5, yaw=0)
    cmd("fill 980 99 -8 1040 99 20 air", f"item replace entity {P} hotbar.0 with dirt 64")
    # The test server's Grim checks where you look when placing (RotationPlace); 2b2t's doesn't.
    out = client("select 1", ".set scaffold rotate true", ".toggle scaffold on", "wait 2", "hold forward,sprint 30", "wait 32", "status", ".toggle scaffold off", ".set scaffold rotate false")
    # Every block it walked over from the floor's edge (z=-8), however far it got (Rotate breaks sprint at each one).
    _, y, z = position()
    path = range(-7, math.floor(z) + 1)
    placed = sum(passed(f"if block 1000 99 {bz} dirt") for bz in path)
    return len(path) >= 4 and placed == len(path) and y >= 99.9, f"{placed}/{len(path)} blocks bridged under the path, y={y:.2f}"


def t_offhand():
    reset()
    cmd(f"item replace entity {P} inventory.5 with totem_of_undying")
    client(".toggle offhand on", "wait 20", ".toggle offhand off")
    return item(-106) == "minecraft:totem_of_undying", f"off hand holds {item(-106) or 'nothing'}"


def t_offhand_sprinting():
    # Grim cancels a click while you sprint (and, from 1.21.2, while you walk) without telling the client: the totem has
