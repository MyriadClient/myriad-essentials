def t_replenish_sprinting():
    # Two low stacks while sprinting: both topped up in one go, the click got past Grim's sprint check in the same tick
    # (stop and start around it), so the sprint never breaks.
    reset()
    cmd(f"item replace entity {P} hotbar.0 with cobblestone 1", f"item replace entity {P} inventory.0 with cobblestone 64",
        f"item replace entity {P} hotbar.1 with dirt 2", f"item replace entity {P} inventory.1 with dirt 64")
    client("hold forward,sprint 40", "wait 5", ".toggle replenish on", "wait 35", ".toggle replenish off")
    x = position()[0]
    # Sprinting covers about 5.6 blocks a second: 2 s of it, less the run-up.
    return count(0) == 64 and count(1) == 64 and x > 1010, f"hotbar stacks now {count(0)} and {count(1)}, ran to x={x:.1f}"


def t_auto_armor():
    reset()
    cmd(*(f"item replace entity {P} inventory.{i} with diamond_{p}" for i, p in enumerate(["helmet", "chestplate", "leggings", "boots"])))
    client(".toggle auto_armor on", "wait 40", ".toggle auto_armor off")
