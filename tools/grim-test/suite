    main = [items.get(i) for i in range(9, 36)]
    used = [s for s in main if s]
    packed = all(s is not None for s in main[:len(used)])
    kinds = {}
    for item, n in used: kinds.setdefault(item, []).append(n)
    merged = all(sum(1 for n in ns if n < SORT_ITEMS[item]) <= 1 for item, ns in kinds.items())
    now = {}
    for item, n in used: now[item] = now.get(item, 0) + n
    hotbar_now = [items.get(i, ("", 0))[0] for i in range(9)]
    ok = packed and merged and now == totals and hotbar_now == hotbar
    return ok, (f"main inventory {'sorted' if packed and merged else 'not sorted'}, {'nothing lost' if now == totals else f'items changed: {now} vs {totals}'}, "
                f"hotbar {'as it was' if hotbar_now == hotbar else hotbar_now}")


