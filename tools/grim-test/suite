SORT_ITEMS = {"cobblestone": 64, "dirt": 64, "oak_planks": 64, "sand": 64, "glass": 64, "iron_ingot": 64, "ender_pearl": 16, "snowball": 16}


def chest_items(x, y, z):
    """A chest's contents on the server: {slot: (item, count)}."""
    # One entry at a time: a whole list comes back cut short.
    out = cmd(*(f"data get block {x} {y} {z} Items[{i}]" for i in range(27)))
    items = {}
    for entry in re.findall(r"\{[^{}]*\}", out):
        slot, item, n = re.search(r"Slot: (\d+)b", entry), re.search(r'id: "([^"]+)"', entry), re.search(r"count: (\d+)", entry)
        if slot and item and n: items[int(slot.group(1))] = (item.group(1).removeprefix("minecraft:"), int(n.group(1)))
    return items


def sort_pass(full_inventory=False, click_after=None, middle=False, by_hand=False):
    """Auto Sort on a double chest of scattered part stacks, opened by hand: merged, packed from the first slot, nothing lost
    and nothing left on the cursor or in your inventory. click_after: you click a chest slot that many ticks after opening it,
    which stops the sort: what it held is put down, and nothing is lost. middle: Auto Sort off, sorted by Inventory Tweaks'
    middle-click over a chest slot instead. by_hand: the chest opened with the right button held a moment and the middle
    button held a few ticks, as by hand: the releases come with the sort under way, and must not count as clicks."""
    import random
    x0, y, z = 10000, 100, 0
    client(*FRESH, "wait 5")
    forceload_area(x0 - 8, z - 8, x0 + 8, z + 8)
    rng = random.Random(7)
    halves = {z: [], z + 1: []}
    totals = {}
    for zz in halves:
        for slot in rng.sample(range(27), 20):
            item = rng.choice(list(SORT_ITEMS))
            n = rng.randint(1, SORT_ITEMS[item] // 2)
            halves[zz].append(f"item replace block {x0 + 2} {y} {zz} container.{slot} with {item} {n}")
            totals[item] = totals.get(item, 0) + n
    # Facing west, the left half's other half is north of it.
    cmd(f"fill {x0 - 4} {y - 1} {z - 4} {x0 + 4} {y - 1} {z + 4} stone", f"fill {x0 - 4} {y} {z - 4} {x0 + 4} {y + 3} {z + 4} air",
        f"setblock {x0 + 2} {y} {z} chest[facing=west,type=right]", f"setblock {x0 + 2} {y} {z + 1} chest[facing=west,type=left]",
        *halves[z], *halves[z + 1],
        f"gamemode survival {P}", f"clear {P}", *([f"item replace entity {P} inventory.{i} with torch 64" for i in range(27)] if full_inventory else []),
        f"tp {P} {x0 + 0.5} {y} {z + 1.0} -90 25")
    settle(x0 + 0.5, y, z + 1.0)
    client(".toggle auto_sort off" if middle else ".toggle auto_sort on", ".toggle inventory_tweaks on", ".set inventory_tweaks middle_sort true", "wait 5",
        timeout=30)
    mark()
    start = time.time()
    # The second slot of the chest's top row, where the screenshots put it.
    opening = ["mouse 1 press", "wait 12", "mouse 1 release"] if by_hand else ["use"]
    middle_click = ["wait 20", "cursor slot 1", "mouse 2 press", "wait 8", "mouse 2 release"] if by_hand else ["wait 20", "cursor slot 1", "mouse 2 click"]
    client(*opening, *([f"wait {click_after}", "cursor slot 1", "mouse 0 click"] if click_after is not None else []),
        *(middle_click if middle else []), timeout=30)
    # Sorted on the server: polled until it is (or 20 s).
    def state():
        a, b = chest_items(x0 + 2, y, z + 1), chest_items(x0 + 2, y, z)
        return [a.get(i) for i in range(27)] + [b.get(i) for i in range(27)], [b.get(i) for i in range(27)] + [a.get(i) for i in range(27)]
    def packed(slots):
        used = [s for s in slots if s]
        if any(s is None for s in slots[:len(used)]): return False
        kinds = {}
        for item, n in used: kinds.setdefault(item, []).append(n)
        return all(sum(1 for n in ns if n < SORT_ITEMS[item]) <= 1 for item, ns in kinds.items())
    took = None
    while time.time() - start < (6 if click_after is not None else 20):
        if any(packed(order) for order in state()):
            took = time.time() - start
            break
        time.sleep(0.25)
    time.sleep(1)
    carried = re.search(r"carried=(.+?) screen=", client("wait 2", "status", timeout=30))
    carried = carried.group(1) if carried else "?"
    client(".toggle auto_sort off", "wait 2", timeout=30)
    now = {}
    for item, n in filter(None, state()[0]): now[item] = now.get(item, 0) + n
    # Parked in your inventory and not put back would show here (the torches of a full inventory aren't the chest's).
    # One entry at a time: a whole list comes back cut short.
    for entry in re.findall(r"\{[^{}]*\}", cmd(*(f"data get entity {P} Inventory[{i}]" for i in range(41)))):
        item, n = re.search(r'id: "minecraft:([a-z_]+)"', entry), re.search(r"count: (\d+)", entry)
        if item and n and item.group(1) in SORT_ITEMS: now[item.group(1)] = now.get(item.group(1), 0) + int(n.group(1))
    kept = now == totals
    sorted_ok = took is not None or click_after is not None
    text = (f"sorted in {took:.1f} s" if took is not None else "stopped by the click" if click_after is not None else "not sorted in 20 s")
    return sorted_ok and kept and carried == "none", text + (", nothing lost" if kept else f", items changed: {now} vs {totals}") + f", cursor {carried}"


SHULKER_COLORS = ["red", "blue", "lime", "yellow", "purple", "black", "white", "cyan"]


def slots_of(target, n):
    """{slot: (item, count)} of a block's Items (target "block x y z") or the tester's Inventory (target "entity"), read a
    field at a time: a whole entry comes back cut short when it holds a shulker box's contents."""
    path = "Items" if target.startswith("block") else "Inventory"
    where = target if target.startswith("block") else f"entity {P}"
    out = cmd(*(f"data get {where} {path}[{i}].{f}" for i in range(n) for f in ("Slot", "id", "count"))).splitlines()
    found = {}
    for i in range(n):
        lines = out[3 * i:3 * i + 3]
        if len(lines) < 3 or any("Found no" in l for l in lines): continue
        slot, item, count = (re.search(r"data: (.*)$", l) for l in lines)
        if slot and item and count:
            found[int(re.sub(r"\D", "", slot.group(1)))] = (item.group(1).strip('"').removeprefix("minecraft:"), int(re.sub(r"\D", "", count.group(1))))
    return found


def box_with(where, color, n):
    """Whether a {color} shulker box holding exactly n dirt in its first slot is in {where} ("block x y z" or the tester)."""
    match = f'{{id:"minecraft:{color}_shulker_box",components:{{"minecraft:container":[{{slot:0,item:{{id:"minecraft:dirt",count:{n}}}}}]}}}}'
    return passed(f"if data {where} Items[{match}]") if where.startswith("block") else passed(f"if data entity {P} Inventory[{match}]")


def stack_limit(item):
    return 1 if item.endswith("shulker_box") else SORT_ITEMS.get(item, 64)


def sorted_and_merged(slots):
    """Whether a run of slots (each (item, count) or None) is packed from the first and every item fills its stacks."""
    used = [x for x in slots if x]
    if any(x is None for x in slots[:len(used)]): return False
    kinds = {}
    for item, n in used: kinds.setdefault(item, []).append(n)
    return all(sum(1 for n in ns if n < stack_limit(item)) <= 1 for item, ns in kinds.items())


def shulker_sort_pass(mode):
    """Sorts with shulker boxes in the mix (they don't stack and each carries its contents, the heaviest updates there are):
    "auto" or "middle" sort a double chest of boxes and part stacks with Auto Sort or a middle-click, "auto_carry" the same
    with boxes in your inventory too (left alone), "inventory" your own inventory by middle-click. Every box must come out
    with its own contents (n dirt each), nothing lost, the cursor empty."""
    import random
    x0, y, z = 10000, 100, 0
    client(*FRESH, "wait 5")
    if "screen=none" not in client("status", timeout=30): client("key escape", "wait 5", timeout=30)
    forceload_area(x0 - 8, z - 8, x0 + 8, z + 8)
    rng = random.Random(23)
    boxes, totals, setup = [], {}, []
    def add(item, n):
        totals[item] = totals.get(item, 0) + n
    def box_item(color, n):
        return f'{color}_shulker_box[container=[{{slot:0,item:{{id:"dirt",count:{n}}}}},{{slot:5,item:{{id:"iron_ingot",count:{n}}}}}]]'
    chest = mode != "inventory"
    if chest:
        halves = [z, z + 1]
        spots = [(zz, s) for zz in halves for s in range(27)]
        rng.shuffle(spots)
        for k in range(16):
            zz, slot = spots.pop()
            color = rng.choice(SHULKER_COLORS)
            boxes.append((color, k + 1))
            setup.append(f"item replace block {x0 + 2} {y} {zz} container.{slot} with {box_item(color, k + 1)}")
            add(f"{color}_shulker_box", 1)
        for k in range(4):
            zz, slot = spots.pop()
            setup.append(f"item replace block {x0 + 2} {y} {zz} container.{slot} with white_shulker_box")
            add("white_shulker_box", 1)
        for k in range(14):
            zz, slot = spots.pop()
            item = rng.choice(list(SORT_ITEMS))
            n = rng.randint(1, SORT_ITEMS[item] // 2)
            setup.append(f"item replace block {x0 + 2} {y} {zz} container.{slot} with {item} {n}")
            add(item, n)
    carried = []
    if mode in ("auto_carry", "inventory"):
        for k, slot in enumerate(rng.sample(range(27), 12 if mode == "inventory" else 6)):
            if k % 3 == 2 and mode == "inventory":
                item = rng.choice(list(SORT_ITEMS))
                n = rng.randint(1, SORT_ITEMS[item] // 2)
                setup.append(f"item replace entity {P} inventory.{slot} with {item} {n}")
                add(item, n)
                continue
            color = rng.choice(SHULKER_COLORS)
            boxes.append((color, 40 + k))
            carried.append(slot + 9)
            setup.append(f"item replace entity {P} inventory.{slot} with {box_item(color, 40 + k)}")
            add(f"{color}_shulker_box", 1)
    cmd(f"fill {x0 - 4} {y - 1} {z - 4} {x0 + 4} {y - 1} {z + 4} stone", f"fill {x0 - 4} {y} {z - 4} {x0 + 4} {y + 3} {z + 4} air",
        f"gamemode survival {P}", f"clear {P}", f"item replace entity {P} hotbar.0 with diamond_sword",
        *([f"setblock {x0 + 2} {y} {z} chest[facing=west,type=right]", f"setblock {x0 + 2} {y} {z + 1} chest[facing=west,type=left]"] if chest else []),
        *setup, f"tp {P} {x0 + 0.5} {y} {z + 1.0} -90 25")
    settle(x0 + 0.5, y, z + 1.0)
    inv_before = slots_of("entity", 41)
    client(".toggle auto_sort " + ("on" if mode.startswith("auto") else "off"), ".toggle inventory_tweaks on", ".set inventory_tweaks middle_sort true",
        "wait 5", timeout=30)
    mark()
    start = time.time()
    if chest:
        client("use", *(["wait 20", "cursor slot 1", "mouse 2 click"] if mode == "middle" else []), timeout=30)
    else:
        client("key e", "wait 10", "cursor slot 20", "mouse 2 click", timeout=30)
    def state():
        a, b = slots_of(f"block {x0 + 2} {y} {z + 1}", 27), slots_of(f"block {x0 + 2} {y} {z}", 27)
        return [a.get(i) for i in range(27)] + [b.get(i) for i in range(27)], [b.get(i) for i in range(27)] + [a.get(i) for i in range(27)]
    def done():
        if chest: return any(sorted_and_merged(order) for order in state())
        inv = slots_of("entity", 41)
        return sorted_and_merged([inv.get(i) for i in range(9, 36)])
    took = None
    while time.time() - start < 30:
        if done():
            took = time.time() - start
            break
        time.sleep(0.5)
    time.sleep(1)
    st = client("wait 2", "status", timeout=30)
    cursor = re.search(r"carried=(.+?) screen=", st)
    cursor = cursor.group(1) if cursor else "?"
    client(".toggle auto_sort off", "key escape", "wait 5", timeout=30)
    now = {}
    places = []
    if chest:
        for zz in (z, z + 1):
            for item, n in slots_of(f"block {x0 + 2} {y} {zz}", 27).values(): now[item] = now.get(item, 0) + n
            places.append(f"block {x0 + 2} {y} {zz}")
    inv_after = slots_of("entity", 41)
    for slot, (item, n) in inv_after.items():
        if item in totals and slot != 0: now[item] = now.get(item, 0) + n
    places.append("entity")
    lost = [f"{c} {n}" for c, n in boxes if not any(box_with(w, c, n) for w in places)]
    kept = now == totals
    untouched = mode != "auto_carry" or all(inv_before.get(s) == inv_after.get(s) for s in carried)
    ok = took is not None and kept and not lost and cursor == "none" and untouched
    return ok, ((f"sorted in {took:.1f} s" if took is not None else "not sorted in 30 s") + (", nothing lost" if kept else f", items changed: {now} vs {totals}")
                + (f", boxes not found as they were: {lost}" if lost else f", all {len(boxes)} boxes with their contents") + f", cursor {cursor}"
                + ("" if untouched else ", your boxes moved"))


