def t_elytra_altitude():
    client(*FRESH, "wait 20")
    cmd(f"clear {P}", f"gamemode survival {P}", f"item replace entity {P} armor.chest with elytra", f"tp {P} 2000.5 230 0.5 -90 0")
    time.sleep(1.5)
    mark()
    x0 = position()[0]
    client(".set elytra_fly type altitude", ".toggle elytra_fly on", "wait 200", ".toggle elytra_fly off", timeout=90)
    x, y, _ = position()
    wear = re.search(r"damage\"?: (\d+)", data("Inventory[{Slot:102b}]"))
    return x - x0 > 60 and y > 150, f"{x - x0:.0f} blocks in 10 s, y={y:.0f}, elytra damage {wear.group(1) if wear else 0}"


def t_elytra_no_durability():
    client(*FRESH, "wait 20")
    cmd(f"clear {P}", f"gamemode survival {P}", f"item replace entity {P} armor.chest with elytra", f"item replace entity {P} hotbar.1 with diamond_chestplate",
        f"tp {P} 3000.5 300 0.5 -90 0")
    time.sleep(1.5)
    mark()
    # Elytra Swap when you fly yourself (Altitude has breaks instead). The elytra opened as a player does, jump pressed
    # while falling, then gliding on its own, looking a little down. What it wore before Elytra Swap was on doesn't count.
    client(".toggle elytra_swap off", ".set elytra_swap when_you_fly true", "look -90 10", "hold jump 2", "wait 5", timeout=30)
    before = elytra_damage()
    client(".toggle auto_armor on", ".toggle elytra_swap on", "wait 200", ".toggle auto_armor off", ".toggle elytra_swap off", "wait 20", timeout=90)
    damage = elytra_damage() - before
    hp, x = health(), position()[0]
    return 0 <= damage <= 2 and hp > 0 and x > 3060, f"elytra damage {damage} after 10 s of flight, {x - 3000:.0f} blocks, health {hp:.0f}"


def health():
    m = re.search(r"([\d.]+)f", data("Health"))
    return float(m.group(1)) if m else 0


def t_elytra_no_durability_landing():
    # Elytra Swap keeps the server from gliding you, so it counts every block you come down as a fall; gliding down
    # to the ground afterwards must not cost any of it.
    client(*FRESH, "wait 20")
    # Force-loaded chunks take the fill without anyone there; then stand on the floor while setting up.
    forceload_area(4990, -24, 5400, 24)
    time.sleep(1)
    cmd("fill 4990 150 -20 5400 150 20 stone", f"tp {P} 5000.5 151 10.5 -90 0", f"clear {P}", f"gamemode survival {P}", f"effect clear {P}",
        f"effect give {P} instant_health 1 5 true", f"item replace entity {P} armor.chest with elytra", f"item replace entity {P} hotbar.1 with diamond_chestplate")
    client(".toggle elytra_swap on", ".set elytra_swap when_you_fly true", "look -90 0", timeout=30)
    cmd(f"tp {P} 5000.5 230 10.5 -90 0")
    # Altitude flies a while, then you glide down yourself, Elytra Swap's own swapping (When You Fly) taking over.
    client(".toggle auto_armor on", ".set elytra_fly type altitude", ".toggle elytra_fly on", "wait 120", ".toggle elytra_fly off", "look -90 25", "wait 200", ".toggle auto_armor off",
        ".toggle elytra_swap off", "wait 10", timeout=90)
    x, y, _ = position()
    hp = health()
    # Dying puts you back at spawn, at full health: only a landing out here counts.
    return hp >= 20 and y < 152 and x > 5000, f"landed at y={y:.1f} after {x - 5000:.0f} blocks, health {hp:.1f}"


def recast_highway(*setup, end=4400):
    """A 3-wide obsidian highway at y=200 from x=4000 to `end`, the tester on it facing east, then `setup` commands."""
    client(*FRESH, "wait 20")
    forceload_area(3990, -8, end, 8)
    cmd(f"tp {P} 4000.5 201 0.5 -90 0")
    time.sleep(1.5)
    # In pieces: a fill takes at most 32768 blocks.
    for x in range(3990, end, 400):
        cmd(f"fill {x} 200 -3 {min(x + 399, end)} 206 3 air", f"fill {x} 200 -1 {min(x + 399, end)} 200 1 obsidian")
    cmd(f"clear {P}", f"gamemode survival {P}", f"effect clear {P}",
        f"effect give {P} saturation 1 20 true", f"item replace entity {P} armor.chest with elytra", f"tp {P} 4000.5 201 0.5 -90 0", *setup)
    time.sleep(1)
    # Grim's opinion of the setup (teleporting you mid-move) isn't the module's: count flags from here.
    mark()


def t_elytra_recast():
    recast_highway()
    client(".set elytra_fly obstacles stop", "wait 10", ".set elytra_fly type recast", ".toggle elytra_fly on", "wait 200", ".toggle elytra_fly off", "wait 20", timeout=90)
    x, _, z = position()
    return x - 4000 > 200 and abs(z - 0.5) < 0.2, f"{x - 4000:.0f} blocks in 10 s, {abs(z - 0.5):.2f} off the line"


def t_elytra_recast_obstacles():
    # An ender chest and a 2-deep hole in the lane, Clear: past the chest (walked round with Baritone, or mined), and
    # at the hole either stopped before it (no Baritone and no blocks) or across it with Baritone.
    recast_highway("setblock 4150 201 0 ender_chest", "fill 4250 198 -1 4250 200 1 air",
        f"item replace entity {P} hotbar.0 with netherite_pickaxe[enchantments={{efficiency:5}}]")
    client(".set elytra_fly obstacles clear", "wait 10", ".set elytra_fly type recast", ".toggle elytra_fly on", "wait 400", ".toggle elytra_fly off", "wait 20", timeout=90)
    x, y, _ = position()
    mined = "passed" in cmd("execute if block 4150 201 0 air")
    baritone = has_baritone()
    ok = x > 4160 and y > 200.5 and (x < 4250 or baritone)
    return ok, f"chest {'mined' if mined else 'walked round'}, x={x:.1f} (hole at 4250), y={y:.1f}"


def elytra_damage():
    """The elytra's damage, worn (chest) or swapped off into the hotbar; -1 if it's gone."""
    for slot in ("102b", "0b", "1b", "2b"):
        d = data(f"Inventory[{{Slot:{slot}}}]")
        if "elytra" in d:
            m = re.search(r"damage\"?: (\d+)", d)
            return int(m.group(1)) if m else 0
    return -1


def t_elytra_recast_no_durability():
    # 30 s of bouncing with Elytra Swap: the server's glides must never last the 20 ticks that wear the elytra.
    recast_highway(f"item replace entity {P} hotbar.1 with diamond_chestplate", end=4980)
