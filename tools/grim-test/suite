    reset()
    cmd(f"item replace entity {P} inventory.5 with totem_of_undying")
    client("hold forward,sprint 40", "wait 5", ".toggle offhand on", "wait 35", ".toggle offhand off")
    return item(-106) == "minecraft:totem_of_undying" and item(14) == "", f"off hand holds {item(-106) or 'nothing'}"


