def run_tests(chosen):
    results = []
    for name, test in chosen:
        mark()
        start = time.time()
        try:
            ok, detail = test()
        except Exception as e:
            ok, detail = False, f"error: {e}"
        flagged = flags()
        if flagged and name not in FLAGS_IGNORED: ok = False
        took = time.time() - start
        results.append((name, ok, detail, flagged, took))
        print(f"{'PASS' if ok else 'FAIL'}  {took:5.1f}s  {name:<30} {detail}" + (f"  [flags: {', '.join(flagged)}]" if flagged else ""), flush=True)
        print("RESULT " + json.dumps([name, ok, took]), flush=True)
    return results


def share(chosen, workers):
    """Splits the tests between the workers, longest first onto whoever has least so far (by the last run's times)."""
    try:
        times = json.load(open(TIMES))
    except (OSError, ValueError):
        times = {}
    loads = [[0.0, []] for _ in range(workers)]
    order = {n: i for i, (n, _) in enumerate(chosen)}
    for name, _ in sorted(chosen, key=lambda t: -times.get(t[0], 15)):
        least = min(loads, key=lambda l: l[0])
        least[0] += times.get(name, 15)
        least[1].append(name)
    # Each worker runs its share in the suite's own order.
    return [sorted(names, key=order.get) for _, names in loads]


def run_workers(chosen, workers):
    """One copy of the suite per dev client, each with its share; their lines come through prefixed with the client."""
    shares = share(chosen, workers)
    results, lock = [], threading.Lock()

    def worker(k, names):
        env = dict(os.environ, GRIM_WORKER=str(k), GRIM_TESTS=json.dumps(names))
        proc = subprocess.Popen([sys.executable, os.path.abspath(__file__)], env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in proc.stdout:
            with lock:
                if line.startswith("RESULT "):
                    results.append(json.loads(line[7:]))
                elif line.strip() and not re.match(r"\d+/\d+ passed", line.strip()):
                    print(f"[{k}] {line}", end="", flush=True)
        proc.wait()

    threads = [threading.Thread(target=worker, args=(k + 1, names)) for k, names in enumerate(shares) if names]
    for t in threads: t.start()
    for t in threads: t.join()
    return results


def main():
    args = sys.argv[1:]
    if args == ["--list"]:
        for name, _ in TESTS: print(name)
        return
    workers = 1
    if args[:1] == ["--workers"]:
        workers, args = int(args[1]), args[2:]
    only = json.loads(os.environ["GRIM_TESTS"]) if "GRIM_TESTS" in os.environ else None
    chosen = [(n, f) for n, f in TESTS if (only is None or n in only) and (not args or any(a in n for a in args))]
    for k in range(1, workers + 1):
        run = "run" if k == 1 else f"run{k}"
        if "no dev client" in sh("client", "--run", run, "--timeout", "10", "echo ping", timeout=40):
            sys.exit(f"no dev client running in {run} (./clients {workers} starts them; see README)")
    started = time.time()
    if workers > 1:
        results = [(n, ok, "", [], took) for n, ok, took in run_workers(chosen, workers)]
    else:
        results = run_tests(chosen)
    if only is not None: return
    # The times for next run's sharing out.
    try:
        times = json.load(open(TIMES))
    except (OSError, ValueError):
        times = {}
    # Only from tests that passed: one that failed early says nothing about how long it takes.
    times.update({r[0]: round(r[4], 1) for r in results if r[1]})
    json.dump(times, open(TIMES, "w"), indent=1)
    failed = [r for r in results if not r[1]]
    # Known flakes that failed get one more try, alone (on the first client), before they count.
    retry = [r[0] for r in failed if r[0] in FLAKY]
    flaky_passed = []
    if retry:
        print(f"\nRetrying known flakes alone: {', '.join(retry)}", flush=True)
        again = {r[0]: r[1] for r in run_tests([(n, f) for n, f in TESTS if n in retry])}
        flaky_passed = [n for n in retry if again.get(n)]
        failed = [r for r in failed if r[0] not in flaky_passed]
    print(f"\n{len(results) - len(failed)}/{len(results)} passed in {time.time() - started:.0f} s" + (f" ({workers} clients)" if workers > 1 else "")
          + ("; failed: " + ", ".join(r[0] for r in failed) if failed else "")
          + ("; known flakes that passed on retry: " + ", ".join(flaky_passed) if flaky_passed else ""))
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
